<file path="css/estilo_quienSomos.css">
/* ==========================================================================
   HOJA DE ESTILOS - IMAGENOLOGÍA VETERINARIA (PÁGINA "QUIÉNES SOMOS")
   Archivo: css/estilo_quienSomos.css

   ÍNDICE
   1. Variables
   2. Reinicio global y base
   3. Contenedor y utilidades de sección
   4. Botones reutilizables
   5. Barra de navegación
   6. Sección "Quiénes Somos" (texto + imagen)
   7. Sección Misión, Visión y Valores
   8. Sección Nuestro Equipo
   9. Pie de página
   10. Filtros de escala (responsive)
   ========================================================================== */


/* ==========================================================================
   1. VARIABLES
   ========================================================================== */
:root {

    /* ---------- COLORES DE FONDO ---------- */
    --color-fondo-pagina: #030b30;
    --color-fondo-seccion-alterna: #091238;
    --color-fondo-hero-luz: #0f1f5c;
    --color-fondo-barra-navegacion: rgba(3, 11, 48, 0.94);
    --color-fondo-pie-pagina: #020720;
    --color-fondo-tarjeta: #0f1942;
    --color-fondo-etiqueta-flotante: rgba(15, 25, 66, 0.92);
    --color-fondo-insignia-hero: rgba(58, 134, 173, 0.15);
    --color-fondo-boton-contorno-hover: rgba(58, 134, 173, 0.15);

    /* ---------- COLORES DE BORDES ---------- */
    --color-borde-tarjeta: #1e2d66;
    --color-linea-inferior-pie: rgba(255, 255, 255, 0.05);

    /* ---------- COLORES DE ACENTO ---------- */
    --color-acento-azul: #3a86ad;
    --color-acento-azul-claro: #62a3c7;
    --color-acento-turquesa: #2db3be;
    --color-boton-whatsapp: #25d366;
    --color-boton-whatsapp-hover: #20ba5a;
    --color-estrellas-testimonio: #f59e0b;

    /* ---------- SOMBRAS ---------- */
    --color-sombra-boton-principal: rgba(58, 134, 173, 0.35);
    --color-sombra-boton-whatsapp: rgba(37, 211, 102, 0.3);
    --color-sombra-imagen-hero: rgba(0, 0, 0, 0.4);

    /* ---------- COLORES DE TEXTO ---------- */
    --color-texto-principal: #f1f5f9;
    --color-texto-secundario: #94a3b8;
    --color-texto-titulos: #ffffff;
    --color-texto-sobre-acento: #ffffff;

    /* ---------- TIPOGRAFÍA ---------- */
    --fuente-titulos: 'Montserrat', sans-serif;
    --fuente-cuerpo: 'Open Sans', sans-serif;

    /* ---------- MEDIDAS DE ESTRUCTURA ---------- */
    --ancho-maximo-contenedor: 75rem;
    --relleno-lateral-contenedor: clamp(1rem, 0.6rem + 1.6vw, 1.5rem);
    --relleno-vertical-seccion: clamp(3.25rem, 2rem + 4.5vw, 5.625rem);
    --espacio-entre-columnas: clamp(1.5rem, 0.5rem + 3.5vw, 3.125rem);
    --espacio-entre-tarjetas: clamp(1.25rem, 0.8rem + 1.6vw, 1.875rem);
    --alto-barra-navegacion: 4.5rem;

    /* ---------- FORMAS ---------- */
    --radio-borde-boton: 0.375rem;
    --radio-borde-tarjeta: 0.75rem;
    --radio-borde-insignia: 1.25rem;

    /* ---------- ANIMACIONES ---------- */
    --transicion-estandar: all 0.3s ease;
}


/* ==========================================================================
   2. REINICIO GLOBAL Y BASE
   ========================================================================== */
*, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    font-size: 100%;
    scroll-behavior: smooth;
    scroll-padding-top: var(--alto-barra-navegacion);
    overflow-x: hidden;
    width: 100%;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
}

body {
    font-family: var(--fuente-cuerpo);
    background-color: var(--color-fondo-pagina);
    color: var(--color-texto-principal);
    line-height: 1.6;
    min-height: 100vh;
    width: 100%;
    max-width: 100%;
    overflow-x: clip;
}

h1, h2, h3, h4, h5, h6 {
    font-family: var(--fuente-titulos);
    color: var(--color-texto-titulos);
    font-weight: 700;
    overflow-wrap: break-word;
}

a {
    text-decoration: none;
    color: inherit;
    transition: var(--transicion-estandar);
}

img {
    max-width: 100%;
    height: auto;
    display: block;
}

:focus-visible {
    outline: 3px solid var(--color-acento-azul-claro);
    outline-offset: 3px;
}


/* ==========================================================================
   3. CONTENEDOR Y UTILIDADES DE SECCIÓN
   ========================================================================== */
.container {
    width: 100%;
    max-width: var(--ancho-maximo-contenedor);
    margin: 0 auto;
    padding-left: max(var(--relleno-lateral-contenedor), env(safe-area-inset-left));
    padding-right: max(var(--relleno-lateral-contenedor), env(safe-area-inset-right));
}

.section-padding {
    padding: var(--relleno-vertical-seccion) 0;
}

.section-navy {
    background-color: var(--color-fondo-seccion-alterna);
}

.section-header {
    text-align: center;
    max-width: 43.75rem;
    margin: 0 auto clamp(2rem, 1rem + 3vw, 3.125rem) auto;
}

.section-subtitle {
    color: var(--color-acento-azul-claro);
    font-size: 0.88rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    display: block;
    margin-bottom: 0.5rem;
}

.section-title {
    font-size: clamp(1.6rem, 1.2rem + 1.7vw, 2.4rem);
    margin-bottom: 1rem;
}

.section-description {
    color: var(--color-texto-secundario);
    font-size: clamp(0.95rem, 0.92rem + 0.2vw, 1.05rem);
}

.section-desc-space {
    margin-top: 1rem;
}

.section-desc-space-sm {
    margin-top: 0.625rem;
}


/* ==========================================================================
   4. BOTONES REUTILIZABLES
   ========================================================================== */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    padding: 0.75rem 1.625rem;
    border-radius: var(--radio-borde-boton);
    font-family: var(--fuente-titulos);
    font-weight: 600;
    font-size: 0.95rem;
    text-align: center;
    cursor: pointer;
    border: 2px solid transparent;
    transition: var(--transicion-estandar);
}

.btn-primary {
    background-color: var(--color-acento-azul);
    color: var(--color-texto-sobre-acento);
}

.btn-primary:hover {
    background-color: var(--color-acento-azul-claro);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px var(--color-sombra-boton-principal);
}

.btn-outline {
    background-color: transparent;
    border-color: var(--color-acento-azul);
    color: var(--color-texto-titulos);
}

.btn-outline:hover {
    background-color: var(--color-fondo-boton-contorno-hover);
    border-color: var(--color-acento-azul-claro);
}

.btn-whatsapp {
    background-color: var(--color-boton-whatsapp);
    color: var(--color-texto-sobre-acento);
}

.btn-whatsapp:hover {
    background-color: var(--color-boton-whatsapp-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px var(--color-sombra-boton-whatsapp);
}

.btn-full {
    width: 100%;
}


/* ==========================================================================
   5. BARRA DE NAVEGACIÓN
   ========================================================================== */
.navbar {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    background-color: var(--color-fondo-barra-navegacion);
    backdrop-filter: blur(10px);
    z-index: 1000;
    border-bottom: 1px solid var(--color-borde-tarjeta);
    padding: 0.9375rem 0;
}

.navbar-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
}

.brand-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
}

.logo-icon {
    flex-shrink: 0;
}

.logo-icon > img {
    height: 40px;
    width: auto;
    object-fit: contain;
}

.logo-text {
    display: flex;
    flex-direction: column;
}

.logo-title {
    font-family: var(--fuente-titulos);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 1.5px;
    color: var(--color-texto-titulos);
    line-height: 1.1;
}

.logo-subtitle {
    font-family: var(--fuente-titulos);
    font-weight: 400;
    font-size: 0.82rem;
    letter-spacing: 2px;
    color: var(--color-acento-azul-claro);
}

.nav-menu {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 0.2rem + 1.7vw, 1.5625rem);
}

.nav-link {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--color-texto-principal);
    white-space: nowrap;
}

.nav-link:hover {
    color: var(--color-acento-azul-claro);
}

.nav-btn-header {
    padding: 0.5rem 1.125rem;
    font-size: 0.88rem;
    white-space: nowrap;
}

.menu-toggle {
    position: absolute;
    opacity: 0;
    pointer-events: none;
}

.hamburger {
    display: none;
}

.menu-toggle:focus-visible + .hamburger {
    outline: 3px solid var(--color-acento-azul-claro);
    outline-offset: 4px;
    border-radius: 4px;
}


/* ==========================================================================
   6. SECCIÓN "QUIÉNES SOMOS" (texto + imagen)
   ========================================================================== */
.about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--espacio-entre-columnas);
    align-items: center;
}

.about-image-wrapper {
    border-radius: var(--radio-borde-tarjeta);
    overflow: hidden;
    border: 1px solid var(--color-borde-tarjeta);
    box-shadow: 0 20px 40px var(--color-sombra-imagen-hero);
    height: 100%;
    display: flex;
    min-width: 0;
}

.about-image {
    width: 100%;
    height: 100%;
    min-height: 380px;
    object-fit: cover;
    display: block;
    filter: grayscale(0.4) contrast(1.05);
}


/* ==========================================================================
   7. SECCIÓN MISIÓN, VISIÓN Y VALORES
   ========================================================================== */
.mvv-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--espacio-entre-tarjetas);
    margin-top: clamp(2rem, 1rem + 3vw, 3.125rem);
}

.mvv-card {
    background-color: var(--color-fondo-tarjeta);
    border: 1px solid var(--color-borde-tarjeta);
    border-radius: var(--radio-borde-tarjeta);
    padding: clamp(1.75rem, 1.2rem + 1.5vw, 2.1875rem) clamp(1.25rem, 1rem + 1vw, 1.5625rem);
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    min-width: 0;
}

.mvv-card:hover {
    transform: translateY(-5px);
    border-color: var(--color-acento-azul);
    box-shadow: 0 10px 25px var(--color-fondo-insignia-hero);
}

.mvv-icon {
    width: 3.75rem;
    height: 3.75rem;
    background-color: var(--color-fondo-insignia-hero);
    border: 1px solid var(--color-acento-azul);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem auto;
    font-size: 1.6rem;
    color: var(--color-acento-azul-claro);
}

.mvv-card h3 {
    font-size: 1.2rem;
    margin-bottom: 0.9375rem;
    color: var(--color-texto-titulos);
}

.mvv-card p {
    color: var(--color-texto-secundario);
    font-size: 0.9rem;
    line-height: 1.6;
}


/* ==========================================================================
   8. SECCIÓN NUESTRO EQUIPO
   ========================================================================== */
.team-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--espacio-entre-tarjetas);
    margin-top: clamp(2rem, 1rem + 3vw, 3.125rem);
}

.team-card {
    background-color: var(--color-fondo-tarjeta);
    border: 1px solid var(--color-borde-tarjeta);
    border-radius: var(--radio-borde-tarjeta);
    padding: clamp(1.5rem, 1.2rem + 1vw, 1.875rem) clamp(1rem, 0.8rem + 1vw, 1.25rem);
    text-align: center;
    transition: transform 0.3s ease;
    min-width: 0;
}

.team-card:hover {
    transform: translateY(-5px);
}

.team-avatar {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    overflow: hidden;
    margin: 0 auto 1.25rem auto;
    border: 2px solid var(--color-acento-azul);
    background-color: var(--color-fondo-tarjeta);
    display: block;
}

.team-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.team-card h4 {
    font-size: 1.1rem;
    margin-bottom: 0.3125rem;
}

.team-role {
    color: var(--color-acento-azul-claro);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.9375rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.team-bio {
    color: var(--color-texto-secundario);
    font-size: 0.88rem;
    line-height: 1.6;
}


/* ==========================================================================
   9. PIE DE PÁGINA
   ========================================================================== */
.footer {
    background-color: var(--color-fondo-pie-pagina);
    border-top: 1px solid var(--color-borde-tarjeta);
    padding: clamp(2.5rem, 1.5rem + 3vw, 3.75rem) 0 1.875rem 0;
}

/* Después (3 columnas, coincide con el HTML) */
.footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    margin-bottom: 2.5rem;
}

.footer-about p {
    color: var(--color-texto-secundario);
    font-size: 0.88rem;
    margin-top: 0.9375rem;
}

.footer-title {
    font-size: 1rem;
    margin-bottom: 1.25rem;
    color: var(--color-texto-titulos);
}

.footer-links {
    list-style: none;
}

.footer-links li {
    margin-bottom: 0.625rem;
}

.footer-links a {
    color: var(--color-texto-secundario);
    font-size: 0.88rem;
}

.footer-links a:hover {
    color: var(--color-acento-azul-claro);
}

.footer-contact-info {
    color: var(--color-texto-secundario);
    font-size: 0.9rem;
    overflow-wrap: anywhere;
}

.footer-contact-space {
    margin-bottom: 0.9375rem;
}

.footer-btn {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
}

.footer-bottom {
    border-top: 1px solid var(--color-linea-inferior-pie);
    padding-top: 1.5625rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    color: var(--color-texto-secundario);
    font-size: 0.82rem;
}


/* ==========================================================================
   10. FILTROS DE ESCALA (RESPONSIVE)
   ========================================================================== */

/* ---- Pantallas ultra anchas (4K / TV): todo crece un 25 % ---- */
@media (min-width: 2200px) {
    html { font-size: 125%; }
}

/* ---- Monitores grandes (2K): todo crece un 12,5 % ---- */
@media (min-width: 1600px) and (max-width: 2199px) {
    html { font-size: 112.5%; }
}

/* ---- Laptops pequeñas: menú compacto ---- */
@media (max-width: 1100px) {
    .nav-link { font-size: 0.86rem; }
    .nav-btn-header { padding: 0.5rem 0.875rem; font-size: 0.84rem; }
    .logo-title { font-size: 1.05rem; }
}

/* ---- Tabletas y menor: menú hamburguesa, hero apilado, grid a 1 columna ---- */
@media (max-width: 992px) {
    .about-grid {
        grid-template-columns: minmax(0, 1fr);
    }

    .about-image-wrapper {
        max-width: 37.5rem;
        margin: 0 auto;
        width: 100%;
    }

    .mvv-grid,
    .team-grid {
        grid-template-columns: minmax(0, 1fr);
    }

    .footer-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Menú hamburguesa */
    .hamburger {
        display: flex;
        flex-direction: column;
        gap: 5px;
        padding: 0.5rem;
        cursor: pointer;
    }

    .hamburger span {
        width: 1.5625rem;
        height: 3px;
        background-color: var(--color-texto-principal);
        border-radius: 2px;
    }

    .nav-menu {
        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        background-color: var(--color-fondo-pagina);
        border-bottom: 1px solid var(--color-borde-tarjeta);
        flex-direction: column;
        align-items: stretch;
        gap: 0.25rem;
        padding: 1rem var(--relleno-lateral-contenedor) 1.5rem;
        display: none;
        max-height: calc(100vh - var(--alto-barra-navegacion));
        max-height: calc(100dvh - var(--alto-barra-navegacion));
        overflow-y: auto;
    }

    .menu-toggle:checked ~ .nav-menu {
        display: flex;
    }

    .nav-link {
        font-size: 1rem;
        padding: 0.75rem 0.25rem;
        border-bottom: 1px solid var(--color-linea-inferior-pie);
    }

    .nav-btn-header {
        margin-top: 0.75rem;
        width: 100%;
        font-size: 0.95rem;
        padding: 0.75rem 1.125rem;
    }
}

/* ---- Móviles grandes: pie a 1 columna ---- */
@media (max-width: 768px) {
    .footer-bottom {
        flex-direction: column;
        text-align: center;
    }
}

/* ---- Móviles: pie a 1 columna ---- */
@media (max-width: 576px) {
    .footer-grid {
        grid-template-columns: minmax(0, 1fr);
    }
}

/* ---- Móviles muy pequeños: marca compacta ---- */
@media (max-width: 380px) {
    .logo-title { font-size: 0.95rem; letter-spacing: 1px; }
    .logo-subtitle { font-size: 0.72rem; letter-spacing: 1.5px; }
    .brand-logo { gap: 0.5rem; }
    .btn { padding: 0.75rem 1rem; font-size: 0.9rem; }
}

/* ---- Pantallas bajas (móvil horizontal): menos aire vertical ---- */
@media (max-height: 520px) and (orientation: landscape) {
    .section-padding {
        padding: 2.5rem 0;
    }
}

/* ---- Pantallas táctiles: sin "saltos" al pasar el dedo ---- */
@media (hover: none) {
    .btn-primary:hover,
    .btn-whatsapp:hover {
        transform: none;
        box-shadow: none;
    }
}

/* ---- Usuarios que prefieren menos movimiento ---- */
@media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }

    *, *::before, *::after {
        transition: none !important;
    }
}
