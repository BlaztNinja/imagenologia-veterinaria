<file path="admin/index.html">
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Backoffice | Imagenología Veterinaria</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Open+Sans:wght@300;400;500;600&display=swap"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="../css/estilo_home.css">
    <link rel="stylesheet" href="../css/admin.css">
    <script type="module" src="../js/ui/admin.js"></script>
</head>
<body>
    <header class="navbar">
    <div class="container navbar-container admin-navbar">
        <a href="../index.html" class="brand-logo"
           aria-label="Imagenología Veterinaria, ir al sitio público">
            <div class="logo-icon">
                <img
                    src="../img/logo-imagenologia-veterinaria.png"
                    alt=""
                    width="40"
                    height="40"
                >
            </div>

            <div class="logo-text">
                <span class="logo-title">IMAGENOLOGIA</span>
                <span class="logo-subtitle">VETERINARIA</span>
            </div>
        </a>

        <a href="../index.html" class="btn btn-outline admin-volver">
            Volver al sitio público
        </a>
    </div>
</header>

    <main class="container admin-contenido">
        <div class="admin-introduccion">
            <span class="section-subtitle">Administración</span>
            <h1 class="section-title">Contenido de la clínica</h1>
            <p class="section-description">
                Gestioná los datos de contacto, los servicios y los requisitos del paciente.
            </p>
        </div>

        <p id="mensaje" role="status" aria-live="polite">
            Comprobando sesión…
        </p>

        <section id="acceso" class="panel acceso" hidden>
            <h2>Acceso del personal</h2>
            <p class="admin-ayuda">
                Ingresá con tu cuenta del personal.
            </p>

            <form id="form-login">
                <label for="email">Correo electrónico</label>
                <input id="email" name="email" type="email"
                       autocomplete="username" required>

                <label for="password">Contraseña</label>
                <input id="password" name="password" type="password"
                       autocomplete="current-password" required>

                <button type="submit">Ingresar</button>
            </form>
        </section>

        <section id="backoffice" hidden>
            <div class="barra">
                <p id="usuario"></p>
                <button id="logout" type="button" class="secundario">
                    Cerrar sesión
                </button>
            </div>

            <section class="panel">
                <h2>Datos de contacto</h2>
                <p class="admin-ayuda">
                    Se muestran en la página de contacto y en el pie de página del sitio.
                </p>

                <form id="form-contacto">
                    <fieldset id="campos-contacto">
                        <legend>Editar datos de contacto</legend>
                        <div class="contacto-grid">
                            <div>
                                <label for="telefono">Teléfono</label>
                                <input id="telefono" name="telefono" type="tel"
                                       maxlength="25" autocomplete="tel" required>
                            </div>

                            <div>
                                <label for="correo-contacto">Correo electrónico</label>
                                <input id="correo-contacto" name="correo" type="email"
                                       maxlength="254" autocomplete="email" required>
                            </div>
                        </div>

                        <label for="horarios">Horarios de atención</label>
                        <textarea id="horarios" name="horarios" rows="4"
                                  aria-describedby="ayuda-horarios" required></textarea>
                        <small id="ayuda-horarios">
                            Escribí un horario por línea.
                        </small>

                        <div class="acciones">
                            <button type="submit">Guardar contacto</button>
                        </div>
                    </fieldset>

                    <p id="mensaje-contacto" role="status" aria-live="polite" hidden></p>
                </form>
            </section>

            <section class="panel">
                <div class="barra">
                    <h2>Servicios y requisitos</h2>
                    <button id="recargar" type="button" class="secundario">
                        Recargar contenido
                    </button>
                </div>

                <h3>Servicios</h3>
                <ul id="lista-servicios" class="lista"></ul>

                <h3>Requisitos del paciente</h3>
                <ul id="lista-requisitos" class="lista"></ul>
            </section>

            <section id="editor" class="panel" hidden>
                <h2 id="titulo-editor">Editar contenido</h2>

                <form id="form-editor">
                    <fieldset id="campos-editor">
                        <legend>Editar contenido</legend>
                        <label for="nombre">Nombre o título</label>
                        <input id="nombre" name="nombre" type="text"
                               maxlength="150" required>

                        <label for="descripcion">Descripción o indicaciones</label>
                        <textarea id="descripcion" name="descripcion"
                                  rows="5" maxlength="3000" required></textarea>

                        <div id="campos-servicio">
                            <label for="precio">Precio en USD</label>
                            <input id="precio" name="precio" type="number"
                                   min="0" max="99999999.99" step="0.01">

                            <label for="detalles">Detalles del servicio</label>
                            <textarea id="detalles" name="detalles"
                                      rows="5"
                                      aria-describedby="ayuda-detalles"></textarea>
                            <small id="ayuda-detalles">
                                Escribí un detalle por línea.
                            </small>
                        </div>

                        <div class="acciones">
                            <button type="submit">Guardar cambios</button>
                            <button id="cancelar" type="button"
                                    class="secundario">Cancelar</button>
                        </div>
                    </fieldset>
                </form>
            </section>
        </section>

        <noscript>Activá JavaScript para utilizar el backoffice.</noscript>
    </main>
</body>
</html>
